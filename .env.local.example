# ============================================================================
# Luna Next.js client — frontend environment. Set these in the Vercel project.
# Only public values may use the NEXT_PUBLIC_ prefix; secrets stay server-side.
# ============================================================================

# REST API base URL of the separately-hosted Express backend.
# Development:
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production (persistent backend host):
# NEXT_PUBLIC_API_URL=https://luna-api.onrender.com

# Socket.IO URL for realtime DMs/news. Usually the same host as the REST API.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:5000.
# Development:
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Production:
# NEXT_PUBLIC_SOCKET_URL=https://luna-api.onrender.com

# Google OAuth client ID (public; used by the browser when the optional
# "Continue with Google" flow is enabled).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=261611330993-abvp1dejjp8h6phtt9h2g4to981dssjd.apps.googleusercontent.com