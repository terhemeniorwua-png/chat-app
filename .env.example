# ============================================================================
# Luna API server — backend environment (persistent host: Render / Railway /
# Fly.io). NEVER use the defaults here in production; set every value via the
# host's environment panel or secret store. This file stays free of real secrets.
# ============================================================================

# Port the Express + Socket.IO server binds. Cloud hosts usually inject this
# automatically (Render sets PORT). Defaults to 5000 for local development.
PORT=5000

# MongoDB Atlas connection string. The backend is the ONLY process that talks
# to the database — never expose this to the Next.js frontend.
MONGODB_URI=mongodb://127.0.0.1:27017/luna
# production: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/luna

# Strong, random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for REST + Socket.IO, comma-separated when needed.
# Development:
CLIENT_URL=http://localhost:3000
# Production (Vercel hostname + any custom domain):
# CLIENT_URL=https://my-app.vercel.app,https://chat.mydomain.com

# Google OAuth (optional wiring — paste your OAuth client ID to enable
# "Continue with Google"). The client ID is public by design and is also shared
# with the frontend via NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=261611330993-abvp1dejjp8h6phtt9h2g4to981dssjd.apps.googleusercontent.com